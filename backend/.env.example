# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (Flutter web). Mobile apps don't need CORS.
CORS_ORIGINS=http://localhost:3000

# Proxy hops in front of the API (Render = 1; Cloudflare + load balancer = 2)
TRUST_PROXY=1

# ---- Database (Supabase Postgres) ----
# Local: printed by `npx supabase status`. Production: Supavisor pooler URL (port 6543, transaction mode).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Supabase ----
SUPABASE_URL=http://127.0.0.1:54321
# Server-side only. NEVER put this in the Flutter app.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: HS256 JWT secret (legacy/local projects). If empty, tokens are verified with the project's JWKS.
SUPABASE_JWT_SECRET=

# ---- Background jobs ----
# true = run the job worker inside the API process (demo on a single Render instance)
WORKER_INLINE=true

# ---- Seeding test accounts (scripts/seed-test-users.ts) ----
TEST_USER_PASSWORD=
TEST_USER_EMAIL_DOMAIN=samayam.test
